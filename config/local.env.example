# 예시 파일입니다. config/local.env 로 복사해서 쓰세요. local.env 는 이 PC 전용이며. GitHub에 올라가지 않습니다 (.gitignore).
# 값은 = 뒤에 붙여 넣으세요. 따옴표는 필요 없습니다.

# 공공데이터포털 인증키 (일반 인증키 Decoding 값)
# PC에서 데이터 갱신(업데이트_Windows.bat)을 직접 돌려 운항 스케줄까지 받을 때만 필요합니다.
DATA_GO_KR_KEY=

# Gemini API 키 (Google AI Studio → Get API key)
# 앱에서는 화면에 입력하는 방식이라, 여기는 개발 중 테스트용 메모 칸입니다.
GEMINI_API_KEY=
